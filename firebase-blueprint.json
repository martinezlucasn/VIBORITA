{
  "entities": {
    "User": {
      "title": "User",
      "description": "Persistent user data",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "coins": { "type": "number" },
        "monedas": { "type": "number" },
        "ownedSkins": { "type": "array", "items": { "type": "string" } },
        "equippedSkin": { "type": "string" },
        "highScore": { "type": "number" },
        "highScoreMonedas": { "type": "number" },
        "lastActive": { "type": "number" },
        "proAccessUntil": { "type": "number" },
        "millonarioAccessUntil": { "type": "number" },
        "inventoryItems": { "type": "object" },
        "inventoryAbilities": { "type": "object" },
        "equippedAbilities": { "type": "array", "items": { "type": "string" } },
        "lastDailyRewardClaim": { "type": "number" },
        "dailyRewardsCycle": { "type": "number" },
        "claimedPlatinumReward": { "type": "boolean" },
        "bio": { "type": "string" },
        "profileTheme": { "type": "string" },
        "profileBorder": { "type": "string" },
        "unlockedThemes": { "type": "array", "items": { "type": "string" } },
        "unlockedBorders": { "type": "array", "items": { "type": "string" } },
        "trophies": { "type": "number" }
      },
      "required": ["displayName", "coins"]
    },
    "TicketPurchase": {
      "title": "TicketPurchase",
      "description": "Log of arena access ticket purchases",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string", "enum": ["pro", "millonario"] },
        "coinsPrice": { "type": "number" },
        "monedasPrice": { "type": "number" },
        "expiry": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "type", "coinsPrice", "monedasPrice", "expiry", "timestamp"]
    },
    "PlayerSession": {
      "title": "PlayerSession",
      "description": "Active player state in the arena",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "segments": { "type": "array", "items": { "type": "object", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } } },
        "angle": { "type": "number" },
        "wager": { "type": "number" },
        "isAlive": { "type": "boolean" },
        "lastUpdate": { "type": "number" },
        "serverId": { "type": "string" },
        "color1": { "type": "string" },
        "color2": { "type": "string" },
        "skinEmoji": { "type": "string" },
        "isBoosting": { "type": "boolean" }
      },
      "required": ["userId", "segments", "angle", "wager", "isAlive", "lastUpdate", "serverId"]
    },
    "WagerPlayer": {
      "title": "WagerPlayer",
      "description": "Presence tracking for wager arena servers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serverId": { "type": "string" },
        "isAlive": { "type": "boolean" },
        "lastUpdate": { "type": "number" }
      },
      "required": ["id", "serverId", "isAlive", "lastUpdate"]
    },
    "Food": {
      "title": "Food",
      "description": "Food items in the arena",
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "value": { "type": "number" },
        "type": { "type": "string", "enum": ["normal", "gold", "speed", "star", "dropped"] },
        "color": { "type": "string" },
        "serverId": { "type": "string" }
      },
      "required": ["x", "y", "value", "type", "serverId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat messages in the arena",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "serverId": { "type": "string" }
      },
      "required": ["userId", "displayName", "text", "timestamp", "serverId"]
    },
    "KillEvent": {
      "title": "KillEvent",
      "description": "Events when a player kills another",
      "type": "object",
      "properties": {
        "killerName": { "type": "string" },
        "victimName": { "type": "string" },
        "timestamp": { "type": "number" },
        "serverId": { "type": "string" }
      },
      "required": ["killerName", "victimName", "timestamp", "serverId"]
    },
    "WagerCoin": {
      "title": "WagerCoin",
      "description": "Coins dropped in the wager arena",
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "value": { "type": "number" },
        "serverId": { "type": "string" },
        "expiresAt": { "type": "number" },
        "color": { "type": "string" }
      },
      "required": ["x", "y", "value", "serverId", "expiresAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Friendship between two users",
      "type": "object",
      "properties": {
        "uids": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "accepted"] },
        "requesterId": { "type": "string" },
        "gamesPlayed": { "type": "number" },
        "level": { "type": "number" },
        "exp": { "type": "number" },
        "lastInteractionTime": { "type": "number" },
        "stats": { 
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "wins": { "type": "number" }
            }
          }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["uids", "status", "requesterId", "gamesPlayed", "timestamp"]
    },
    "PrivateMessage": {
      "title": "PrivateMessage",
      "description": "Messages between friends",
      "type": "object",
      "properties": {
        "friendshipId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["friendshipId", "senderId", "text", "timestamp"]
    },
    "PrivateRoom": {
      "title": "PrivateRoom",
      "description": "Private game rooms for duels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "wager": { "type": "number" },
        "createdAt": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] }
      },
      "required": ["id", "creatorId", "wager", "createdAt", "status"]
    },
    "SkinListing": {
      "title": "SkinListing",
      "description": "Skin listings in the marketplace",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "skinId": { "type": "string" },
        "price": { "type": "number" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "sold"] }
      },
      "required": ["sellerId", "sellerName", "skinId", "price", "timestamp", "status"]
    },
    "AbilityListing": {
      "title": "AbilityListing",
      "description": "Ability listings in the marketplace",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "abilityId": { "type": "string" },
        "price": { "type": "number" },
        "timestamp": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "sold"] }
      },
      "required": ["sellerId", "sellerName", "abilityId", "price", "timestamp", "status"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration for updates",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "minVersion": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "updateMessage": { "type": "string" }
      },
      "required": ["version", "minVersion", "downloadUrl"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "User withdrawal request for coins to fiat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "amount": { "type": "number" },
        "alias": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "timestamp": { "type": "number" },
        "transactionId": { "type": "string" },
        "completedAt": { "type": "number" }
      },
      "required": ["userId", "displayName", "email", "amount", "alias", "status", "timestamp"]
    },
    "CTFRoom": {
      "title": "CTFRoom",
      "description": "Game room for Capture the Flag",
      "type": "object",
      "properties": {
        "betAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["waiting", "playing", "finished"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["betAmount", "status", "updatedAt"]
    }
  },
  "firestore": {
    "/app_config/{configId}": {
      "schema": "AppConfig",
      "description": "Global app configuration documents"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/arenaPlayers/{playerId}": {
      "schema": "PlayerSession",
      "description": "Active players in the arena"
    },
    "/wagerPlayers/{playerId}": {
      "schema": "WagerPlayer",
      "description": "Presence tracking for wager arena"
    },
    "/arenaFood/{foodId}": {
      "schema": "Food",
      "description": "Food items in the arena"
    },
    "/wagerCoins/{coinId}": {
      "schema": "WagerCoin",
      "description": "Dropped coins in the wager arena"
    },
    "/arenaChat/{chatId}": {
      "schema": "ChatMessage",
      "description": "Chat messages in the arena"
    },
    "/arenaKills/{killId}": {
      "schema": "KillEvent",
      "description": "Kill events in the arena"
    },
    "/ticketPurchases/{purchaseId}": {
      "schema": "TicketPurchase",
      "description": "Log of ticket purchases"
    },
    "/friendships/{friendshipId}": {
      "schema": "Friendship",
      "description": "Friendships and friend requests"
    },
    "/privateMessages/{messageId}": {
      "schema": "PrivateMessage",
      "description": "Messages between friends"
    },
    "/privateRooms/{roomId}": {
      "schema": "PrivateRoom",
      "description": "Private game rooms"
    },
    "/skinSales/{listingId}": {
      "schema": "SkinListing",
      "description": "Skin marketplace listings"
    },
    "/abilitySales/{listingId}": {
      "schema": "AbilityListing",
      "description": "Ability marketplace listings"
    },
    "/ctf_rooms/{roomId}": {
      "schema": "CTFRoom",
      "description": "Capture the flag game instances"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "WithdrawalRequest",
      "description": "User withdrawal requests"
    }
  }
}
